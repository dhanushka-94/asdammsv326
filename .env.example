#==============================================================================
# ASDA Member Management System — Environment Example
#==============================================================================
# Full Stack Developers: Dhanushka Bandara, Greshan Bandara
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env
#   php artisan key:generate
#
# Dates & times use Sri Lanka Standard Time (Asia/Colombo, UTC+05:30).
# Do not commit a real ".env" with secrets.
#==============================================================================

#------------------------------------------------------------------------------
# Application
#------------------------------------------------------------------------------
APP_NAME="ASDA Member Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

#------------------------------------------------------------------------------
# Locale & timezone (Sri Lanka)
#------------------------------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_LK
APP_TIMEZONE=Asia/Colombo

#------------------------------------------------------------------------------
# Maintenance & security
#------------------------------------------------------------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12
# PHP_CLI_SERVER_WORKERS=4

#------------------------------------------------------------------------------
# Logging
#------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Database
#------------------------------------------------------------------------------
# Local default: MySQL. For quick SQLite, set DB_CONNECTION=sqlite and comment
# the MySQL host/user/password lines below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asdamms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Sri Lanka Standard Time offset for MySQL session (matches APP_TIMEZONE)
DB_TIMEZONE=+05:30

# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

#------------------------------------------------------------------------------
# Session
#------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

#------------------------------------------------------------------------------
# Cache & queue
#------------------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

#------------------------------------------------------------------------------
# Redis (optional — unused when CACHE/QUEUE/SESSION use database)
#------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

#------------------------------------------------------------------------------
# Mail
#------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@asdamms.com"
MAIL_FROM_NAME="${APP_NAME}"

#------------------------------------------------------------------------------
# AWS / S3 (optional)
#------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#------------------------------------------------------------------------------
# Frontend (Vite)
#------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
